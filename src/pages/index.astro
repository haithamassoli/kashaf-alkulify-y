---
import Base from '../layouts/Base.astro'
import Search from '../islands/Search.tsx'
import Charts from '../components/Charts.astro'
import { articleCount, playlists, totalHours, videos } from '../lib/data'
import { arabicDate, withDigits } from '../lib/format'
import { SITE, SITE_URL, SHEIKH, person } from '../lib/seo'

const options = playlists.map((p) => ({ id: p.id, title: p.title, count: p.videoIds.length }))

const num = (n: number) => n.toLocaleString('en-US')
// transcript lines across every lecture — not the cue count in Meilisearch, which merges these
// into ~75 s windows and is roughly 8x smaller
const segments = videos.reduce((n, v) => n + v.segmentCount, 0)
const lastUpload = videos.map((v) => v.uploadDate ?? '').sort().at(-1)

const cards = [
  {
    label: 'الدروس',
    value: num(videos.length),
    icon: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'm10.3 8.5 5.2 3.5-5.2 3.5Z'],
  },
  {
    label: 'قوائم التشغيل',
    value: num(playlists.length),
    href: '/p/',
    icon: ['M4 7h12M4 12h12M4 17h7', 'm17 13 4 2.5-4 2.5Z'],
  },
  {
    label: 'الساعات المفرَّغة',
    value: num(Math.round(totalHours)),
    icon: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18', 'M12 7.5V12l3 2'],
  },
  {
    label: 'مقاطع التفريغ',
    value: num(segments),
    icon: ['M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2Z', 'M8 9h8M8 13h5'],
  },
  {
    label: 'المقالات',
    value: num(articleCount),
    href: '/a/',
    icon: ['M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z', 'M14 3v5h5', 'M9 13h6M9 17h4'],
  },
  {
    label: 'آخر إضافة',
    value: arabicDate(lastUpload),
    icon: ['M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z', 'M8 3v4M16 3v4M4 11h16'],
  },
]

// ?q= is a real, shareable URL (Search.tsx keeps state there), so the SearchAction is honest.
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE,
      description: `فهرس بحث في نصوص دروس ${SHEIKH} المفرَّغة آليًا.`,
      inLanguage: 'ar',
      about: { '@id': person['@id'] },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
    person,
  ],
}

// Whole-number values stay LTR as one run; Arabic ones only isolate their digits.
const value = (s: string) => (/^[\d,]+$/.test(s) ? `<span class="digits">${s}</span>` : withDigits(s))
---

<Base
  description="ابحث في نصوص دروس الشيخ أبي جعفر عبد الله بن فهد الخليفي المفرَّغة آليًا."
  schema={[siteSchema]}
>
  <section class="home-hero">
    <div class="hero-copy">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">كشّاف أبي جعفر</h1>
      <p class="mt-3 text-muted">ابحث في دروس الشيخ أبي جعفر عبد الله بن فهد الخليفي</p>
    </div>
    <svg class="hero-art" viewBox="0 0 240 180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="120" cy="90" r="72" fill="var(--accent-soft)" stroke="none" />
      <circle cx="120" cy="90" r="83" stroke="var(--border)" stroke-dasharray="3 9" />
      <g class="book">
        <path d="M43 65Q80 53 120 73Q160 53 197 65V139Q159 127 120 147Q81 127 43 139Z" fill="var(--surface)" />
        <path pathLength="1" d="M51 58Q86 50 120 69Q154 50 189 58V130Q153 122 120 141Q87 122 51 130ZM120 69V141" fill="var(--bg)" />
        <path class="page-lines" pathLength="1" d="M65 76Q86 74 106 84M65 89Q86 87 106 97M65 102Q86 100 99 106M134 84Q154 74 175 76M134 97Q154 87 175 89M141 106Q158 101 175 102" stroke-width="1.5" />
        <path d="M159 57V80L167 74L175 77V55" fill="var(--accent-soft)" stroke-width="1.5" />
      </g>
      <g class="search-lens">
        <circle cx="167" cy="112" r="24" fill="var(--accent-soft)" fill-opacity="0.9" stroke-width="3" />
        <path d="M185 130L203 148" stroke-width="7" />
        <path d="M155 108Q158 100 166 100" stroke="var(--surface)" stroke-width="3" />
      </g>
      <g class="spark" stroke-width="1.5">
        <path d="M69 30V42M63 36H75M207 83V93M202 88H212" />
        <circle cx="37" cy="108" r="3" />
        <circle cx="170" cy="28" r="2" fill="currentColor" />
      </g>
    </svg>
  </section>

  <Search client:load playlists={options} />

  <section id="platform-content" class="mt-14 border-t border-border pt-10">
    <h2 class="text-lg font-semibold tracking-tight">محتوى المنصة</h2>
    <p class="mt-2 text-sm text-muted">ما هو متاح في الكشّاف حتى الآن</p>

    <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3">
      {
        cards.map((c) => {
          // The two cards that have somewhere to go become links; the rest stay plain.
          const Cell = c.href ? 'a' : 'div'
          return (
            <li class="card stat-card">
              <Cell
                href={c.href}
                class:list={[
                  'flex items-center justify-between gap-3 px-4 py-4',
                  c.href && 'rounded-[inherit] transition-colors hover:bg-surface-2',
                ]}
              >
                <div class="min-w-0">
                  <span class="block text-sm text-muted">{c.label}</span>
                  <span class="mt-1 block text-xl font-semibold" set:html={value(c.value)} />
                </div>
                <svg
                  class="size-5 shrink-0 text-muted"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  {c.icon.map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              </Cell>
            </li>
          )
        })
      }
    </ul>

    <Charts />
  </section>
</Base>

<style>
  .home-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
  }
  .hero-copy { flex: 1; }
  .hero-art {
    width: 11rem;
    height: auto;
    flex-shrink: 0;
    color: var(--accent);
  }
  .stat-card svg { color: var(--accent); }
  @media (max-width: 479px) {
    .home-hero { gap: 0.5rem; }
    .hero-art { width: 5.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: arrive 700ms ease-out both; }
    .book { animation: arrive 900ms ease-out both; }
    .page-lines {
      stroke-dasharray: 1;
      animation: write 1400ms 350ms ease-out both;
    }
    .search-lens { animation: discover 2600ms 250ms ease-in-out both; }
    .spark {
      transform-box: fill-box;
      transform-origin: center;
      animation: glimmer 1800ms 600ms ease-in-out both;
    }
    .stat-card {
      animation: arrive 600ms ease-out backwards;
      transition: transform 200ms ease, border-color 200ms ease;
    }
    .stat-card:nth-child(2) { animation-delay: 60ms; }
    .stat-card:nth-child(3) { animation-delay: 120ms; }
    .stat-card:nth-child(4) { animation-delay: 180ms; }
    .stat-card:nth-child(5) { animation-delay: 240ms; }
    .stat-card:nth-child(6) { animation-delay: 300ms; }
    .stat-card:focus-within {
      transform: translateY(-3px);
      border-color: var(--accent);
    }
    .stat-card:focus-within svg { animation: icon-nod 450ms ease; }
    @media (hover: hover) {
      .stat-card:hover { transform: translateY(-3px); border-color: var(--accent); }
      .stat-card:hover svg { animation: icon-nod 450ms ease; }
      .home-hero:hover .search-lens { animation: discover-again 1800ms ease-in-out; }
    }
  }
  @keyframes arrive {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes write {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes discover {
    0% { opacity: 0; transform: translate(-45px, -20px); }
    25% { opacity: 1; }
    55% { transform: translate(-55px, -8px); }
    100% { opacity: 1; transform: translate(0, 0); }
  }
  @keyframes discover-again {
    50% { transform: translate(-55px, -8px); }
  }
  @keyframes glimmer {
    0% { opacity: 0; transform: scale(0.8); }
    55% { opacity: 1; transform: scale(1.08); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes icon-nod {
    50% { transform: rotate(-12deg) scale(1.15); }
  }
</style>
