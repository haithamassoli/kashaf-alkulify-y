{
  "name": "kashaf-abu-jaafar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm guard",
    "guard": "(test -d dist/v || (echo 'dynamic routes are missing — check the build-time data path' && false)) && (! grep -rql 'PUBLIC_MEILI_HOST:\"http://127.0.0.1:7700\"' dist/_astro || (echo 'PUBLIC_MEILI_HOST is still localhost — set the public one and rebuild' && false))",
    "preview": "astro preview",
    "meili": "meilisearch --db-path ./data/meili/data.ms --master-key $MEILI_ADMIN_KEY --http-addr 127.0.0.1:7700 --env development",
    "data": "tsx --env-file-if-exists=.env scripts/build-data.ts",
    "articles": "tsx scripts/articles.ts",
    "telegram": "tsx scripts/telegram.ts",
    "index": "tsx --env-file-if-exists=.env scripts/index.ts",
    "embed": "tsx --env-file-if-exists=.env scripts/embed.ts",
    "ingest": "pnpm data && pnpm articles && pnpm telegram && pnpm index",
    "check": "tsx scripts/selfcheck.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify-batch.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "chart.js": "^4.5.1",
    "meilisearch": "^0.62.0",
    "posthog-js": "^1.438.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
